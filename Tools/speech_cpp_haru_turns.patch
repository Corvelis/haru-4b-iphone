+/* Haru for iOS: choose turn-taking for the frames delivered by this push. */
+typedef enum speech_haru_turn {
+    SPEECH_HARU_NORMAL = 0,
+    SPEECH_HARU_LISTENING = 1,
+    SPEECH_HARU_START_REPLY = 2,
+    SPEECH_HARU_CONTINUE_REPLY = 3
+} speech_haru_turn;
+
+typedef enum speech_haru_frame_flag {
+    SPEECH_HARU_TEXT = 1,
+    SPEECH_HARU_END_OF_PAUSE = 2
+} speech_haru_frame_flag;
+
+SPEECH_API speech_status speech_dialogue_push_haru(speech_dialogue * dialogue, const float * samples, size_t n_samples,
+                                                   speech_haru_turn turn);
+/* Read after start or push on the same thread; use the model token before detokenization. */
+SPEECH_API uint32_t speech_dialogue_haru_last_frame_flags(const speech_dialogue * dialogue);
+
 /**
  * Ends the conversation: the audio short of a whole frame is dropped, as the model hears whole frames alone. It returns
  * as speech_dialogue_push() does. Added in 4.2.
diff --git a/src/api/dialogue.cpp b/src/api/dialogue.cpp
index 93faaaf..2e56075 100644
--- a/src/api/dialogue.cpp
+++ b/src/api/dialogue.cpp
@@ -105,13 +105,21 @@ void speech_dialogue_free(speech_dialogue * dialogue) {
 }
 
 speech_status speech_dialogue_push(speech_dialogue * dialogue, const float * samples, size_t n_samples) {
+    return speech_dialogue_push_haru(dialogue, samples, n_samples, SPEECH_HARU_NORMAL);
+}
+
+uint32_t speech_dialogue_haru_last_frame_flags(const speech_dialogue * dialogue) {
+    return dialogue && dialogue->stream ? dialogue->stream->haru_last_frame_flags() : 0;
+}
+
+speech_status speech_dialogue_push_haru(speech_dialogue * dialogue, const float * samples, size_t n_samples, speech_haru_turn turn) {
     return guarded([&] {
         require(dialogue, "dialogue");
         if (n_samples > 0) require(samples, "samples", "audio");
         require_open(*dialogue);
         return feed(*dialogue, [&] {
             dialogue->resampler->push(samples, n_samples, dialogue->resampled);
-            dialogue->stream->push(dialogue->resampled.data(), dialogue->resampled.size());
+            dialogue->stream->push(dialogue->resampled.data(), dialogue->resampled.size(), turn);
         });
     });
 }
